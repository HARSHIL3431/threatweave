# Environment Configuration (all values below are the application defaults)
APP_ENV=development
LOG_LEVEL=INFO
API_VERSION=v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ML Model Configuration (frozen E2 with_port artifact; do not retrain via the API)
MODEL_PATH=../data/processed/experiments/with_port/model.pkl
PREPROCESSING_CONFIG_PATH=../data/processed/experiments/with_port/preprocessing_config.json
ACTIVE_OPERATING_POINT=OP-A

# Intelligence toggles (all off by default; detection works regardless)
MITRE_ENABLED=false
RAG_ENABLED=false
LLM_ENABLED=false

# MITRE ATT&CK knowledge base + RAG retrieval
MITRE_DATA_DIR=../data/mitre
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5

# LLM explanation layer (/explain only; detection never calls the LLM).
# LLM_PROVIDER=mock is deterministic and offline (no key needed).
# Real providers need LLM_API_KEY injected via environment — never commit keys.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60.0
LLM_OPENAI_BASE_URL=https://api.openai.com/v1

# Server-side PDF report output (UUID filenames; never user-supplied paths)
REPORTS_DIR=../data/reports
