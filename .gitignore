# Node.js / Vite
node_modules/
dist/
.vite/
*.tsbuildinfo

# Environment files (never commit secrets)
.env
.env.local
.env.*
!.env.example
!**/.env.example

# Python caches and artifacts
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Raw CICIDS2017 datasets (large files, not versioned)
dataset/
data/combined/*.csv

# MITRE raw bundle and vector store (large / generated)
data/mitre/raw/
data/mitre/vectorstore/

# Isolation Forest experiment score outputs and binaries
data/processed/experiments/*/scores/
*.pkl
*.npy
*.faiss

# Generated report documents
data/reports/

# Experiment and analysis logs
*.log
scripts/*.txt

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Frontend runtime artifacts
frontend/logs/
frontend/.next/
frontend/out/
logs/
*.pid

# Local backups and file snapshots (kept locally, not versioned)
_backup/
_snapshots/

# Design reference kept locally (also copied into frontend/docs/reference)
design-reference/
